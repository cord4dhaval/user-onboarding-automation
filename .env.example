MONGODB_URI=
MONGODB_DB=conversion_engine

# Envelope encryption master key (32 bytes, base64).
# Launch compromise only — move to a managed KMS before onboarding a second tenant.
MASTER_KEY_B64=

# Optional — only needed to run `npm run demo:send -- --live` against a real mailbox.
# Any SMTP works: Gmail app password, Zoho, Brevo, your own server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TeamGrid <hi@yourdomain.com>"

# Public origin of this app. Used to build the OAuth redirect URI.
# Leave blank in local dev — it is derived from the request headers.
APP_URL=

# Protects /api/cron/tick. Leave blank in local dev.
CRON_SECRET=
# Local scheduler target — set to the port `npm run dev` actually prints.
TICK_URL=http://localhost:3000/api/cron/tick

# Bearer token for our own MCP server at /api/mcp. Leave blank in local dev.
MCP_TOKEN=

# Shows a one-click demo sign-in on the login page. Both must be set, or the
# block does not render. Leave blank on a deployment with real customer data.
DEMO_EMAIL=
DEMO_PASSWORD=

# Suggested brand provider, shown on the brand badge when a product has no kit yet.
# Leave unset to offer the generic "connect any brand MCP" route instead.
BRAND_PROVIDER_NAME=
BRAND_PROVIDER_SIGNUP_URL=
BRAND_PROVIDER_MCP_URL=

# Protects /api/test/leads, the fake lead feed used to test a recurring API input.
# Leave blank in local dev; set it on any deployment so it is not an open lead injector.
TEST_FEED_TOKEN=
